VERSION_ENV="260714"

#DEBUG=1

#
# global
#
: ${PKR_VAR_os_user:=vagrant}
: ${PKR_VAR_os_pass:=vagrant}
: ${PKR_VAR_os_out:=/tmp/out}
: ${PKR_VAR_os_anpb:=/pub/pkb/pb}
: ${PKR_VAR_vg_bdir:=/sw/linux/vagrant}
: ${PKR_VAR_vg_burl:=http://app/sw/linux/vagrant}
: ${PKR_VAR_vm_cpu:=2}
: ${PKR_VAR_vm_mem:=4096}
: ${PKR_VAR_vm_disk:=51200}

export PKR_VAR_os_user
export PKR_VAR_os_pass
export PKR_VAR_os_anpb
export PKR_VAR_os_out
export PKR_VAR_vg_bdir
export PKR_VAR_vg_burl
export PKR_VAR_vm_cpu
export PKR_VAR_vm_mem
export PKR_VAR_vm_disk

#
# debian13
#
if [[ "$REPO" =~ ^debian13 ]]; then
  : ${PKR_VAR_os_dist:=debian}
  : ${PKR_VAR_os_ver:="13.6"}
  : ${PKR_VAR_os_web:=apt.dc.local}
fi

if [[ "$REPO" = "debian13-build-base" ]]; then
  : ${PKR_VAR_os_from:=iso}
  : ${PKR_VAR_os_id:=base}
  : ${PKR_VAR_os_iso:=/sw/linux/debian/$PKR_VAR_os_ver/x86_64/$PKR_VAR_os_dist-$PKR_VAR_os_ver.0-amd64-DVD-1.iso}
  INFO="Debian 13 $PKR_VAR_os_id"
fi

if [[ "$REPO" = "debian13-build-post" ]]; then
  : ${PKR_VAR_os_from:=base}
  : ${PKR_VAR_os_id:=post}
  INFO="Debian 13 $PKR_VAR_os_id"
fi

if [[ "$REPO" = "debian13-build-test" ]]; then
  : ${PKR_VAR_os_from:=base}
  : ${PKR_VAR_os_id:=test}
  INFO="Debian 13 $PKR_VAR_os_id"
fi

if [[ "$REPO" = "debian13-build-podman" ]]; then
  : ${PKR_VAR_os_from:=post}
  : ${PKR_VAR_os_id:=podman}
  INFO="Debian 13 $PKR_VAR_os_id"
fi

if [[ "$REPO" = "debian13-build-vagrant" ]]; then
  : ${PKR_VAR_os_from:=post}
  : ${PKR_VAR_os_id:=vagrant-$PKR_VAR_os_from}
  INFO="Debian 13 vagrant $PKR_VAR_os_from"
fi

